DEMO_MODE=false
# Хэш для демо-PIN "1234". Для своего PIN запустите: python hash_password.py
ADMIN_PASSWORD_HASH=03ac674216f3e15c761ee1a5e255f067953623c8b388b4459e13f978d7c846f4

